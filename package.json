{
  "name": "image-to-pdf-converter",
  "version": "1.0.0",
  "description": "Web-based Image to PDF Converter",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "client": "cd frontend && npm start",
    "dev": "concurrently \"npm run start\" \"npm run client\"",
    "build": "cd frontend && npm run build"
  },
  "dependencies": {
    "concurrently": "^8.2.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "html-pdf": "^3.0.1",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.2.19",
    "sharp": "^0.32.6"
  }
}
